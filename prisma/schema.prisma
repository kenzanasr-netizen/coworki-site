generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  PARTNER
  COMPANY
  ADMIN
}

enum PartnerStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum VerificationChannel {
  EMAIL
  PHONE
}

enum VerificationPurpose {
  REGISTER
  LOGIN
  RESET_PASSWORD
}

model User {
  id                String             @id @default(cuid())
  fullName          String
  email             String             @unique
  passwordHash      String
  phone             String?
  role              Role               @default(USER)
  interests         String[]
  emailVerified     Boolean            @default(false)
  phoneVerified     Boolean            @default(false)
  isActive          Boolean            @default(false)
  profile           Profile?
  partner           Partner?
  company           Company?
  reservations      Reservation[]
  favorites         Favorite[]
  reviews           Review[]
  payments          Payment[]
  notifications     Notification[]
  verificationCodes VerificationCode[]
  adminActionLogs   AdminActionLog[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Profile {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatar     String?
  bio        String?
  city       String?
  occupation String?
  interests  String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Partner {
  id          String        @id @default(cuid())
  userId      String        @unique
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  status      PartnerStatus @default(PENDING)
  spaces      Space[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Company {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName    String
  taxNumber      String?
  billingAddress String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Space {
  id              String          @id @default(cuid())
  partnerId       String?
  partner         Partner?        @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  name            String
  city            String
  address         String
  description     String?
  services        String[]
  images          String[]
  price2h         Int?
  price4h         Int?
  priceDay        Int?
  capacity        Int?
  isPublished     Boolean         @default(false)
  reservations    Reservation[]
  favorites       Favorite[]
  reviews         Review[]
  dailyCapacities DailyCapacity[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Reservation {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  spaceId   String
  space     Space             @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  date      DateTime
  duration  String
  total     Int
  status    ReservationStatus @default(PENDING)
  payment   Payment?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, spaceId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model Payment {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservationId String      @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  amount        Int
  provider      String
  status        String
  createdAt     DateTime    @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model VerificationCode {
  id        String              @id @default(cuid())
  userId    String?
  user      User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String?
  phone     String?
  channel   VerificationChannel
  purpose   VerificationPurpose @default(REGISTER)
  codeHash  String
  used      Boolean             @default(false)
  expiresAt DateTime
  createdAt DateTime            @default(now())

  @@index([email, channel, purpose])
  @@index([phone, channel, purpose])
}

model DailyCapacity {
  id                String   @id @default(cuid())
  spaceId           String
  space             Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  date              DateTime
  capacity          Int      @default(0)
  remainingCapacity Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([spaceId, date])
}

model AdminActionLog {
  id         String   @id @default(cuid())
  adminId    String?
  admin      User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action     String
  targetId   String?
  targetType String?
  metadata   Json?
  createdAt  DateTime @default(now())
}
